# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# JWT
JWT_SECRET=your_jwt_secret_here

# 服务端口
FLASK_PORT=5001
STREAMLIT_PORT=8501
# Flask 绑定地址：本地用 127.0.0.1，公网部署用 0.0.0.0（建议前面挂 Nginx 反代）
FLASK_HOST=127.0.0.1

# 数据库
DATABASE_URI=sqlite:///lake_eval.db

# 默认管理员
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 游客限制（按 IP）
GUEST_DAILY_CHAT_LIMIT=5
GUEST_MAX_TOKENS=500
GUEST_TOKEN_EXPIRY_HOURS=2

# 安全
# CORS 白名单（逗号分隔），公网部署改为你的前端域名
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# 全局 IP 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# 本地知识库 RAG
# 是否启用知识库（AI 回答会自动引用 knowledge_base/ 目录下的 txt/md 文件内容）
KB_ENABLED=true
# 知识库目录（相对项目根，默认为 knowledge_base/）
KB_DIR=knowledge_base
# 切块大小（字符）：单块最大字符数
KB_CHUNK_SIZE=600
# 块重叠字符（避免上下文断裂）
KB_CHUNK_OVERLAP=80
# 单问题检索返回的 top-k 块数
KB_TOP_K=3
# 最低相似度阈值（0~1）：低于该阈值的块不注入，避免无关内容干扰
KB_MIN_SCORE=0.12
